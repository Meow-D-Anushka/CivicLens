# Server
PORT=5000
NODE_ENV=development

# CORS: the deployed frontend's origin (no trailing slash).
FRONTEND_URL="http://localhost:3000"

# Aiven Postgres connection string.
# Find it on your Aiven service's Overview page as "Service URI" — it already
# includes sslmode=require, e.g.:
# postgres://avnadmin:PASSWORD@your-service-name.aivencloud.com:PORT/defaultdb?sslmode=require
DATABASE_URL="postgres://user:password@host:port/dbname?sslmode=require"

# Aiven's server certificate chains to Aiven's own CA, which Node doesn't
# trust by default, so full TLS verification is off unless you turn this on.
# To turn it on: download the CA cert from Aiven's console, save it (e.g. as
# backend/aiven-ca.pem — .gitignored), set PGSSLROOTCERT to that path, and
# set this to true.
PGSSL_REJECT_UNAUTHORIZED=false
# PGSSLROOTCERT="./aiven-ca.pem"
